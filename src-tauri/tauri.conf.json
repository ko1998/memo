{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "备忘录",
  "version": "1.0.0",
  "identifier": "com.local.memo",
  "build": {
    "frontendDist": "../content"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "备忘录",
        "width": 300,
        "height": 420,
        "minWidth": 240,
        "minHeight": 300,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
